# Copy to .env for local development (deno task dev reads it), and set these as
# environment variables in the Deno Deploy dashboard for production.

# The single shared instructor password.
ADMIN_PASSWORD=change-me-in-production

# Signs the instructor session cookie. Use a long random string.
SESSION_SECRET=generate-a-long-random-string-here

# Optional: override the hourly submission ceiling per IP (default 200).
# RATE_LIMIT_SUBMISSIONS_PER_HOUR=200

# Optional: override the hourly login attempt ceiling per IP (default 30).
# RATE_LIMIT_LOGINS_PER_HOUR=30
