# Copy to .dev.vars for local development, and set these as secrets in production.
# ADMIN_PASSWORD is the single shared instructor password.
ADMIN_PASSWORD=change-me-in-production

# SESSION_SECRET signs the instructor session cookie. Use a long random string.
SESSION_SECRET=generate-a-long-random-string-here

# Optional: override the hourly submission ceiling per IP (default 200).
# RATE_LIMIT_SUBMISSIONS_PER_HOUR=200
